# LLM configuration.
# Triage uses the agreed clinical model through a text-generation provider.
# Chat uses a separate chat-capable model for follow-up questions.
# Without an API key, triage returns conservative safety fallback guidance.

TRIAGE_LLM_BASE_URL=https://router.huggingface.co/featherless-ai/v1
TRIAGE_LLM_MODEL=m42-health/Llama3-Med42-8B
CHAT_LLM_BASE_URL=https://router.huggingface.co/v1
CHAT_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct:fastest
MEDICAL_LLM_API_KEY=hf_your_token_here
